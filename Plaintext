name: Build Tailwind CSS

# 每次有人 push 改動到 index.html / tailwind.config.js / src/input.css,
# 就自動在 GitHub 自己的伺服器上重新編譯出 styles.css,並 commit 回這個 repo。
# 你完全不需要在自己電腦上安裝 Node/npm,也不需要手動執行任何指令。
on:
  push:
    branches: [main]
    paths:
      - 'index.html'
      - 'tailwind.config.js'
      - 'src/input.css'
  workflow_dispatch: {}

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Set up Node
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Install Tailwind CLI
        run: npm install -D tailwindcss@3.4.17

      - name: Build static CSS
        run: npx tailwindcss -i ./src/input.css -o ./styles.css --minify

      - name: Commit built CSS back to the repo
        uses: stefanzweifel/git-auto-commit-action@v5
        with:
          commit_message: "chore: auto-build styles.css from Tailwind source"
          file_pattern: styles.css
